{
  "name": "sylph-tanstack-template",
  "version": "0.3.0",
  "description": "TanStack Start, shadcn/ui, Effect, Better Auth, and Alchemy on Cloudflare Workers",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "cloudflare": {
    "label": "TanStack Start app with Better Auth",
    "products": [
      "Workers",
      "D1"
    ],
    "categories": [
      "starter"
    ]
  },
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "sylph:preview": "bun scripts/sylph-deploy.ts deploy",
    "sylph:preview:destroy": "bun scripts/sylph-deploy.ts destroy",
    "sylph:deploy": "bun scripts/sylph-deploy.ts deploy",
    "sylph:plan": "bun scripts/sylph-resources.ts",
    "sylph:release:review": "bun scripts/sylph-release.ts review",
    "sylph:release:prepare": "bun scripts/sylph-release.ts prepare",
    "sylph:release:restore": "bun scripts/sylph-release.ts restore",
    "sylph:release:verify": "bun scripts/sylph-release.ts verify",
    "sylph:release:resume": "bun scripts/sylph-release.ts resume"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.111",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.20.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "alchemy": "2.0.0-beta.74",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/platform-bun": "4.0.0-rc.111"
  },
  "overrides": {
    "effect": "4.0.0-rc.111",
    "@effect/platform-node-shared": "4.0.0-rc.111"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20"
  }
}
