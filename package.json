{
  "name": "sylph-tanstack-template",
  "version": "0.1.0",
  "description": "TanStack Start, shadcn/ui, Effect, Better Auth, and Alchemy on Cloudflare Workers",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "cloudflare": {
    "label": "TanStack Start app with Better Auth",
    "products": [
      "Workers",
      "D1"
    ],
    "categories": [
      "starter"
    ]
  },
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "sylph:preview": "bun scripts/sylph-deploy.ts deploy",
    "sylph:preview:destroy": "bun scripts/sylph-deploy.ts destroy",
    "sylph:deploy": "bun scripts/sylph-deploy.ts deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.111",
    "lucide-react": "^1.34.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "@tailwindcss/vite": "^4",
    "@types/bun": "1.4.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "alchemy": "2.0.0-beta.74",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8"
  },
  "overrides": {
    "effect": "4.0.0-rc.111"
  },
  "packageManager": "bun@1.2.7",
  "engines": {
    "node": ">=20"
  }
}
