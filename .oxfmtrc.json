{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    ".alchemy/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/.output/**",
    "**/.tanstack/**",
    "src/routeTree.gen.ts",
    "README.md"
  ]
}
